# Esta configuración apunta a producción y siempre permanece en solo lectura.
# Para probar, usa las variables del proyecto jovenes-de-fuego-staging en .env.local y agrega:
# VITE_FIREBASE_TARGET=staging
# VITE_FIREBASE_READ_ONLY_PRODUCTION=false
