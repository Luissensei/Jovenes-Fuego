VITE_FIREBASE_AUTH_DOMAIN=jovenes-de-fuego.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=jovenes-de-fuego
VITE_FIREBASE_STORAGE_BUCKET=jovenes-de-fuego.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=222344810816
VITE_FIREBASE_APP_ID=1:222344810816:web:91898b0e914ce5f40b6aa5
VITE_FIREBASE_READ_ONLY_PRODUCTION=true

# Para habilitar Fuego AI en jovenes-de-fuego-staging, configura estas variables
# en el entorno Preview del proyecto Vercel "jovenes-fuego-staging".
# Usa los valores Web del proyecto Firebase jovenes-de-fuego-staging, NO los de producción:
# VITE_FIREBASE_TARGET=staging
# VITE_FIREBASE_READ_ONLY_PRODUCTION=false
# VITE_FIREBASE_API_KEY=<API_KEY_PUBLICA_DE_STAGING>
# VITE_FIREBASE_AUTH_DOMAIN=jovenes-de-fuego-staging.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=jovenes-de-fuego-staging
# VITE_FIREBASE_STORAGE_BUCKET=<STORAGE_BUCKET_DE_STAGING>
# VITE_FIREBASE_MESSAGING_SENDER_ID=<SENDER_ID_DE_STAGING>
# VITE_FIREBASE_APP_ID=<APP_ID_DE_STAGING>
# VITE_FIREBASE_APP_CHECK_SITE_KEY=<CLAVE_PUBLICA_RECAPTCHA_V3>
#
# Registra la app web de Staging en Firebase App Check y registra el dominio
# de Vercel en la consola reCAPTCHA. La clave secreta se guarda SOLO en Firebase,
# nunca en Vercel ni en el frontend. Habilita Firebase AI Logic y aplica App Check
# para Firebase AI Logic en el proyecto staging.
