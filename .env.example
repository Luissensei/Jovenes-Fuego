# Configuración local y de Preview: Firebase Staging.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=jovenes-de-fuego-staging
VITE_FIREBASE_STORAGE_BUCKET=
