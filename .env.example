# Firebase de Staging (predeterminado para desarrollo y pruebas).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=jovenes-de-fuego-staging
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_READ_ONLY=false

# Para una vista previa autorizada conectada al proyecto original:
# VITE_FIREBASE_PROJECT_ID=jovenes-de-fuego
# VITE_FIREBASE_AUTH_DOMAIN=jovenes-de-fuego.firebaseapp.com
# VITE_FIREBASE_READ_ONLY=true
# Completa API_KEY y APP_ID con los valores de la aplicación web original.
# No incluyas aquí claves privadas ni JSON de cuentas de servicio.
