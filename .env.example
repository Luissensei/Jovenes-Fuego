# Configuración pública de Firebase para Jóvenes de Fuego.
# El frontend está enlazado al proyecto original "jovenes-de-fuego"
# en src/services/firebase/client.ts. No apuntes este repositorio a staging.
#
# Única variable opcional que consume actualmente el cliente:
# Clave pública de sitio de reCAPTCHA Enterprise usada por Firebase App Check.
# Si se deja vacía, la app utiliza la clave pública registrada en el código.
VITE_FIREBASE_APP_CHECK_SITE_KEY=
